ionally a person; also (from the rapid breathing in passion) ire","k":"anger(-gry), [phrase] before, countenance, face, [phrase] forebearing, forehead, [phrase] (long-) suffering, nose, nostril, snout, [idiom] worthy, wrath.","o":"from H599 (אָנַף);","f":276,"es":[["furor",98],["ira",81],["enojo",21],["rostro",15]]},"640":{"l":"אָפַד","x":"ʼâphad","p":"aw-fad'","d":"to gird on (the ephod)","k":"bind, gird.","o":"a primitive root (rather a denominative from H646 (אֵפוֹד));","f":2,"es":[["ephod",4],["ceñirás",1],["ajustólo",1]]},"641":{"l":"אֵפֹד","x":"ʼÊphôd","p":"ay-fode'","d":"Ephod, an Israelite","k":"Ephod.","o":"the same as H646 (אֵפוֹד) shortened;","f":1,"es":[["ephod",1]]},"642":{"l":"אֵפֻדָּה","x":"ʼêphuddâh","p":"ay-food-daw'","d":"a girding on (of the ephod); hence, generally, a plating (of metal)","k":"ephod, ornament.","o":"feminine of H646 (אֵפוֹד);","f":3,"es":[["cinto",1],["ephod",1],["vestidura",1]]},"643":{"l":"אַפֶּדֶן","x":"ʼappeden","p":"ap-peh'-den","d":"a pavilion or palace-tent","k":"palace.","o":"apparently of foreign derivation;","f":1,"es":[["palacio",1]]},"644":{"l":"אָפָה","x":"ʼâphâh","p":"aw-faw'","d":"to cook, especially to bake","k":"bake(-r, (-meats)).","o":"a primitive root;","f":25,"es":[["panaderos",6],["panadero",3],["coció",2],["cocerá",2]]},"645":{"l":"אֵפוֹ","x":"ʼêphôw","p":"ay-fo'","d":"strictly a demonstrative particle, here; but used of time, now or then","k":"here, now, where?","o":"or אֵפוֹא; from H6311 (פֹּה);","f":15,"es":[["ahora",8],["pues",2],["vino",1],["aquí",1]]},"646":{"l":"אֵפוֹד","x":"ʼêphôwd","p":"ay-fode'","d":"a girdle; specifically the ephod or highpriest's shoulder-piece; also generally, an image","k":"ephod.","o":"rarely אֵפֹד; probably of foreign derivation","f":49,"es":[["ephod",43]]},"647":{"l":"אֲפִיחַ","x":"ʼĂphîyach","p":"af-ee'-akh","d":"Aphiach, an Israelite","k":"Aphiah.","o":"perhaps from H6315 (פּוּחַ); breeze;","f":1,"es":[["aphia",1]]},"648":{"l":"אָפִיל","x":"ʼâphîyl","p":"aw-feel'","d":"unr